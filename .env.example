DB_USER=todo_user
# Usá una contraseña larga y aleatoria real, no la dejes en un valor conocido:
DB_PASSWORD=CAMBIAR_ESTA_CLAVE
DB_NAME=todo_db

# Opcional: orígenes extra permitidos por CORS, separados por coma
# (dejar vacío en producción: el frontend habla con el backend a través
# del mismo origen vía el proxy de Nginx, no hace falta abrir CORS a nadie más)
# ALLOWED_ORIGIN=http://localhost:5500,https://mi-otro-dominio.com
